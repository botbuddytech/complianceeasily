// ---------------------------------------------------------------------------
// Spine
// ---------------------------------------------------------------------------

model User {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String            @unique
  passwordHash   String            @map("password_hash")
  fullName       String            @default("") @map("full_name")
  role           UserRole          @default(client_user)
  status         UserAccountStatus @default(active)
  phone          String?
  avatarInitials String?           @map("avatar_initials")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         WorkspaceMember[]
  professional        Professional?
  staffUser           StaffUser?
  assignmentsAssigned ProfessionalAssignment[] @relation("AssignedBy")

  @@map("users")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members                 WorkspaceMember[]
  clients                 Client[]
  entities                Entity[]
  filings                 Filing[]
  documents               Document[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  protectionClaims        ProtectionClaim[]
  notificationPreferences NotificationPreference[]
  supportTickets          SupportTicket[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  memberRole  MemberRole   @default(collaborator) @map("member_role")
  status      MemberStatus @default(active)
  lastActive  DateTime?    @map("last_active") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Plan {
  id           PlanId   @id
  name         String
  priceDisplay String   @map("price_display")
  period       String   @default("month")
  features     Json     @default("[]")
  isPublic     Boolean  @default(true) @map("is_public")

  clients       Client[]
  entities      Entity[]
  subscriptions Subscription[]

  @@map("plans")
}

model Client {
  id                 String       @id
  workspaceId        String       @map("workspace_id") @db.Uuid
  businessName       String       @map("business_name")
  contactName        String       @map("contact_name")
  email              String
  entityCount        Int          @default(0) @map("entity_count")
  planId             PlanId       @default(free) @map("plan_id")
  healthScore        Int          @default(0) @map("health_score")
  filingsDueThisWeek Int          @default(0) @map("filings_due_this_week")
  protectionActive   Boolean      @default(false) @map("protection_active")
  state              String
  joinedAt           DateTime     @default(dbgenerated("current_date")) @map("joined_at") @db.Date
  status             ClientStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace                   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                        Plan                        @relation(fields: [planId], references: [id])
  entities                    Entity[]
  propertyAssets              PropertyAsset[]
  stockHoldings               StockHolding[]
  stockLedgerEntries          StockLedgerEntry[]
  investmentComplianceItems   InvestmentComplianceItem[]

  @@index([workspaceId])
  @@map("clients")
}

model Entity {
  id                 String   @id
  clientId           String   @map("client_id")
  workspaceId        String   @map("workspace_id") @db.Uuid
  name               String
  shortName          String   @map("short_name")
  entityType         String   @map("entity_type")
  gstin              String?
  pan                String?
  cin                String?
  state              String
  locations          Int      @default(1)
  industry           String
  healthScore        Int      @default(0) @map("health_score")
  healthLabel        String   @default("New") @map("health_label")
  planId             PlanId   @default(free) @map("plan_id")
  protectionActive   Boolean  @default(false) @map("protection_active")
  radarActive        Boolean  @default(true) @map("radar_active")
  employees          Int?
  annualTurnoverInr  BigInt?  @map("annual_turnover_inr")
  registrations      String[] @default([])
  activities         String[] @default([])
  createdAt          DateTime @default(dbgenerated("current_date")) @map("created_at") @db.Date
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client                   Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                     Plan                      @relation(fields: [planId], references: [id])
  filings                  Filing[]
  documents                Document[]
  assignments              ProfessionalAssignment[]
  triggerMatches           EntityTriggerMatch[]
  bankConnections          BankConnection[]
  emailConnections         EmailConnection[]
  statementUploads         StatementUpload[]
  booksIntegrations        BooksIntegration[]
  ledgerAccounts           LedgerAccount[]
  ledgerEntries            LedgerEntry[]
  gstReturns               GstReturn[]
  tdsReturns               TdsReturn[]
  itrReturns               ItrReturn[]
  entityGstProfile         EntityGstProfile?
  entityTdsProfile         EntityTdsProfile?
  entityItrProfile         EntityItrProfile?
  protectionClaims         ProtectionClaim[]

  @@index([clientId])
  @@index([workspaceId])
  @@map("entities")
}

model Professional {
  id             String              @id
  userId         String?             @unique @map("user_id") @db.Uuid
  name           String
  email          String
  type           ProfessionalType
  registrationNo String?             @map("registration_no")
  status         ProfessionalStatus  @default(available)
  specialties    String[]            @default([])
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments  ProfessionalAssignment[]
  filings      Filing[]
  documents    Document[]

  @@map("professionals")
}

model ProfessionalAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professionalId String   @map("professional_id")
  entityId       String   @map("entity_id")
  assignedById   String?  @map("assigned_by") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  active         Boolean  @default(true)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  entity       Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  assignedBy   User?        @relation("AssignedBy", fields: [assignedById], references: [id])

  @@unique([professionalId, entityId])
  @@index([professionalId])
  @@index([entityId])
  @@map("professional_assignments")
}

model Filing {
  id                  String       @id
  entityId            String       @map("entity_id")
  workspaceId         String       @map("workspace_id") @db.Uuid
  triggerId           String?      @map("trigger_id")
  name                String
  shortName           String       @map("short_name")
  department          String
  category            String
  dueDate             DateTime     @map("due_date") @db.Date
  periodLabel         String       @map("period_label")
  status              FilingStatus @default(upcoming)
  protectionEligible  Boolean      @default(false) @map("protection_eligible")
  professionalId      String?      @map("professional_id")
  notes               String?
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity       Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trigger      ComplianceTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  professional Professional?      @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  reminders    Reminder[]
  claims       ProtectionClaim[]

  @@index([entityId])
  @@index([professionalId])
  @@index([dueDate])
  @@index([status])
  @@map("filings")
}

// ---------------------------------------------------------------------------
// Trigger catalogue
// ---------------------------------------------------------------------------

model TriggerMeta {
  id           Int      @id @default(1)
  version      String
  lastVerified DateTime @map("last_verified") @db.Date
  disclaimer   String
  sources      Json     @default("[]")

  @@map("trigger_meta")
}

model TriggerType {
  id          String @id
  label       String
  subtitle    String
  description String
  iconName    String @map("icon_name")

  triggers ComplianceTrigger[]

  @@map("trigger_types")
}

model GovDepartment {
  id           String    @id
  name         String
  shortName    String    @map("short_name")
  level        DeptLevel
  ministry     String
  regulator    String
  portalUrl    String    @map("portal_url")
  otherPortals String[]  @default([]) @map("other_portals")
  categoryIds  String[]  @default([]) @map("category_ids")
  description  String
  iconName     String    @map("icon_name")

  triggers ComplianceTrigger[]

  @@map("gov_departments")
}

model TriggerCategory {
  id            String   @id
  name          String
  code          String
  departmentIds String[] @default([]) @map("department_ids")
  description   String

  triggers ComplianceTrigger[]

  @@map("trigger_categories")
}

model ComplianceTrigger {
  id                  String            @id
  name                String
  shortName           String            @map("short_name")
  departmentId        String            @map("department_id")
  categoryId          String            @map("category_id")
  triggerTypeId       String            @map("trigger_type")
  priority            TriggerPriority   @default(medium)
  status              TriggerStatus     @default(active)
  legalReference      String            @default("") @map("legal_reference")
  forms               String[]          @default([])
  description         String            @default("")
  sourceUrl           String            @default("") @map("source_url")
  lastVerified        DateTime?         @map("last_verified") @db.Date
  applicability       Json              @default("{}")
  schedule            Json              @default("{}")
  notification        Json              @default("{}")
  thresholds          Json              @default("[]")
  penaltySummary      Json              @default("{}") @map("penalty_summary")
  linkedServiceIds    String[]          @default([]) @map("linked_service_ids")
  protectionEligible  Boolean           @default(false) @map("protection_eligible")
  professionalType    ProfessionalType  @default(CA) @map("professional_type")
  ruleId              String?           @map("rule_id")
  complianceId        String?           @map("compliance_id")
  jurisdictionId      String?           @map("jurisdiction_id")
  obligationKind      String            @default("mandatory_if_applicable") @map("obligation_kind")
  scopeLevel          String            @default("central") @map("scope_level")
  verificationStatus  String            @default("imported_unverified") @map("verification_status")
  deadlineText        String            @default("") @map("deadline_text")
  scheduleSource      String            @default("curated_unverified") @map("schedule_source")
  automationEnabled   Boolean           @default(false) @map("automation_enabled")
  processJson         Json              @default("{}") @map("process_json")
  documentsJson       Json              @default("[]") @map("documents_json")
  conditionJson       Json?             @map("condition_json")
  evidenceJson        Json              @default("[]") @map("evidence_json")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department   GovDepartment       @relation(fields: [departmentId], references: [id])
  category     TriggerCategory     @relation(fields: [categoryId], references: [id])
  triggerType  TriggerType         @relation(fields: [triggerTypeId], references: [id])
  ruleVersion  CatalogueRuleVersion? @relation(fields: [ruleId], references: [ruleId])
  compliance   CatalogueCompliance?  @relation(fields: [complianceId], references: [complianceId])
  jurisdiction Jurisdiction?         @relation(fields: [jurisdictionId], references: [jurisdictionId])
  matches      EntityTriggerMatch[]
  filings      Filing[]

  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
  @@index([ruleId])
  @@index([jurisdictionId])
  @@index([verificationStatus])
  @@index([automationEnabled])
  @@map("compliance_triggers")
}

model EntityTriggerMatch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId     String   @map("entity_id")
  triggerId    String   @map("trigger_id")
  applies      Boolean
  result       String   @default("not_applicable")
  reasons      Json     @default("[]")
  missingFacts Json     @default("[]") @map("missing_facts")
  evaluatedAt  DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(6)

  entity  Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  trigger ComplianceTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@unique([entityId, triggerId])
  @@index([entityId])
  @@map("entity_trigger_matches")
}

model Reminder {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filingId  String           @map("filing_id")
  channel   NotifyChannel
  leadDays  Int              @map("lead_days")
  fireAt    DateTime         @map("fire_at") @db.Timestamptz(6)
  status    ReminderStatus   @default(pending)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  filing Filing            @relation(fields: [filingId], references: [id], onDelete: Cascade)
  jobs   NotificationJob[]

  @@unique([filingId, channel, leadDays])
  @@index([fireAt])
  @@map("reminders")
}

model NotificationJob {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reminderId  String?               @map("reminder_id") @db.Uuid
  channel     NotifyChannel
  status      NotificationJobStatus @default(pending)
  payload     Json                  @default("{}")
  error       String?
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime?             @map("processed_at") @db.Timestamptz(6)

  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("notification_jobs")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id                      String         @id
  entityId                String         @map("entity_id")
  workspaceId             String         @map("workspace_id") @db.Uuid
  name                    String
  category                String
  fileType                String         @map("file_type")
  sizeBytes               BigInt         @default(0) @map("size_bytes")
  storagePath             String?        @map("storage_path")
  status                  DocumentStatus @default(uploaded)
  uploadedBy              String         @map("uploaded_by")
  reviewerProfessionalId  String?        @map("reviewer_professional_id")
  uploadedAt              DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  entity   Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewer Professional? @relation(fields: [reviewerProfessionalId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([reviewerProfessionalId])
  @@index([status])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Books
// ---------------------------------------------------------------------------

model BankConnection {
  id                   String           @id
  entityId             String           @map("entity_id")
  bankName             String           @map("bank_name")
  bankCode             BankCode         @map("bank_code")
  accountNumberMasked  String           @map("account_number_masked")
  accountType          AccountType      @default(Current) @map("account_type")
  status               ConnectionStatus @default(disconnected)
  lastSyncedAt         DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  balance              String           @default("₹0")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("bank_connections")
}

model EmailConnection {
  id              String           @id
  entityId        String           @map("entity_id")
  provider        EmailProvider
  email           String?
  status          ConnectionStatus @default(disconnected)
  lastSyncedAt    DateTime?        @map("last_synced_at") @db.Timestamptz(6)
  invoicesFetched Int              @default(0) @map("invoices_fetched")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("email_connections")
}

model StatementUpload {
  id                 String          @id
  entityId           String          @map("entity_id")
  fileName           String          @map("file_name")
  bankName           String?         @map("bank_name")
  uploadedAt         DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  status             StatementStatus @default(processing)
  transactionsFound  Int             @default(0) @map("transactions_found")
  periodLabel        String          @default("") @map("period_label")

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("statement_uploads")
}

model BooksIntegration {
  id           String              @id
  entityId     String              @map("entity_id")
  category     IntegrationCategory
  code         String
  name         String
  description  String              @default("")
  status       ConnectionStatus    @default(disconnected)
