// ComplianceEasily — Prisma schema (mirrors supabase/migrations/*)
// Auth: app-managed users table + HTTP-only session cookies (no Supabase Auth).
// RLS policies remain in SQL for defence-in-depth; Prisma uses DATABASE_URL and bypasses RLS — keep it server-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

