  coverageId           String  @id @map("coverage_id")
  jurisdictionId       String  @map("jurisdiction_id")
  topic                String
  applicabilityStatus  String? @map("applicability_status")
  authorityUrl         String? @map("authority_url")
  applicationUrl       String? @map("application_url")
  sourceId             String? @map("source_id")
  coverageStatus       String  @default("discovery_only") @map("coverage_status")
  nextVerification     String? @map("next_verification")

  jurisdiction Jurisdiction?    @relation(fields: [jurisdictionId], references: [jurisdictionId])
  source       CatalogueSource? @relation(fields: [sourceId], references: [sourceId])
  linkedRules  CoverageRule[]

  @@unique([jurisdictionId, topic])
  @@index([jurisdictionId])
  @@index([topic])
  @@map("state_coverage")
}

model CoverageRule {
  coverageRuleId String @id @map("coverage_rule_id")
  coverageId     String @map("coverage_id")
  ruleId         String @map("rule_id")

  coverage StateCoverage        @relation(fields: [coverageId], references: [coverageId], onDelete: Cascade)
  rule     CatalogueRuleVersion @relation(fields: [ruleId], references: [ruleId], onDelete: Cascade)

  @@unique([coverageId, ruleId])
  @@map("coverage_rules")
}

model StatePropertyProfile {
  propertyProfileId   String    @id @map("property_profile_id")
  jurisdictionId      String    @unique @map("jurisdiction_id")
  recordTerms         String?   @map("record_terms")
  termsStatus         String?   @map("terms_status")
  rorUrl              String?   @map("ror_url")
  registrationUrl     String?   @map("registration_url")
  mutationUrl         String?   @map("mutation_url")
  landRevenueUrl      String?   @map("land_revenue_url")
  sourceId            String?   @map("source_id")
  serviceSourceId     String?   @map("service_source_id")
  routeStatus         String?   @map("route_status")
  physicalStepsStatus String?   @map("physical_steps_status")
  restrictionReview   String?   @map("restriction_review")
  titleNote           String?   @map("title_note")
  checkedOn           DateTime? @map("checked_on") @db.Date

  jurisdiction  Jurisdiction?    @relation(fields: [jurisdictionId], references: [jurisdictionId])
  source        CatalogueSource? @relation("PropertyPrimarySource", fields: [sourceId], references: [sourceId])
  serviceSource CatalogueSource? @relation("PropertyServiceSource", fields: [serviceSourceId], references: [sourceId])

  @@map("state_property_profiles")
}

model EvidenceAssertion {
  assertionId        String  @id @map("assertion_id")
  ruleId             String  @map("rule_id")
  sourceId           String? @map("source_id")
  fieldName          String? @map("field_name")
  finding            String?
  verificationStatus String? @map("verification_status")

  rule   CatalogueRuleVersion @relation(fields: [ruleId], references: [ruleId], onDelete: Cascade)
  source CatalogueSource?     @relation(fields: [sourceId], references: [sourceId])

  @@index([ruleId])
  @@map("evidence_assertions")
}

model FieldReview {
  reviewId        String @id @map("review_id")
  ruleId          String @map("rule_id")
  fieldName       String @map("field_name")
  reviewStatus    String @default("unreviewed") @map("review_status")
  evidenceIdsJson Json   @default("[]") @map("evidence_ids_json")
  reviewNote      String? @map("review_note")

  rule CatalogueRuleVersion @relation(fields: [ruleId], references: [ruleId], onDelete: Cascade)

  @@unique([ruleId, fieldName])
  @@map("field_reviews")
}

model CorrectionLog {
  correctionId         String  @id @map("correction_id")
  legacyRowId          String? @map("legacy_row_id")
  fieldName            String? @map("field_name")
  originalValue        String? @map("original_value")
  replacementOrAction  String? @map("replacement_or_action")
  sourceId             String? @map("source_id")
  status               String?

  source CatalogueSource? @relation(fields: [sourceId], references: [sourceId])

  @@map("correction_log")
}
